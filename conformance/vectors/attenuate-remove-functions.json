{
  "format": 1,
  "name": "attenuate-remove-functions",
  "description": "removeFunctions at each index removes every occurrence, keeps order, ignores absent names and prefixes, can empty the list, and is refused at the length, 2^31 and 2^32 - 1.",
  "rules": [
    {
      "contract": "746f6b656e",
      "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
      "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
    },
    {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
    {
      "contract": "646578",
      "functions": ["73776170"],
      "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
    }
  ],
  "batch": [
    {
      "call": {
        "contract": "746f6b656e",
        "function": "7472616e73666572",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "746f6b656e",
        "function": "617070726f7665",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "746f6b656e",
        "function": "6275726e",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "706f6f6c",
        "function": "6465706f736974",
        "args": [{"address": "626f62"}]
      }
    },
    {"call": {"contract": "646578", "function": "73776170", "args": [{"address": "616c696365"}]}},
    {"call": {"contract": "646578", "function": "73776170", "args": [{"address": "626f62"}]}}
  ],
  "expected": {"allows": [true, true, true, true, true, false], "allows_all": false},
  "attenuations": [
    {
      "steps": [{"remove_functions": {"index": 0, "functions": ["7472616e73666572"]}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["617070726f7665", "6275726e"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [false, true, true, true, true, false],
          "allows_all": false
        }
      }
    },
    {
      "steps": [{"remove_functions": {"index": 0, "functions": ["617070726f7665"]}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["7472616e73666572", "6275726e", "7472616e73666572"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [true, false, true, true, true, false],
          "allows_all": false
        }
      }
    },
    {
      "steps": [{"remove_functions": {"index": 0, "functions": []}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [true, true, true, true, true, false],
          "allows_all": false
        }
      }
    },
    {
      "steps": [{"remove_functions": {"index": 0, "functions": ["6d696e74"]}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [true, true, true, true, true, false],
          "allows_all": false
        }
      }
    },
