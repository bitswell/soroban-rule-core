{
  "format": 1,
  "name": "cap-limit-inclusive",
  "description": "A spend taking the total exactly to the limit passes; one more is refused, and so is a single spend over the limit.",
  "limit": "100",
  "period": 10,
  "params_valid": true,
  "start": {"history": [], "total": "0"},
  "calls": [
    {"now": 1, "amount": "101", "expected": {"error": "limit_exceeded"}},
    {
      "now": 1,
      "amount": "100",
      "expected": {"ok": {"history": [{"ledger": 1, "amount": "100"}], "total": "100"}}
    },
    {"now": 1, "amount": "1", "expected": {"error": "limit_exceeded"}},
    {"now": 2, "amount": "1", "expected": {"error": "limit_exceeded"}}
  ]
}
