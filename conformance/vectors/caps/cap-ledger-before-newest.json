{
  "format": 1,
  "name": "cap-ledger-before-newest",
  "description": "A positive spend at a ledger earlier than the newest entry is refused; the newest ledger itself and later ones pass.",
  "limit": "100",
  "period": 10,
  "params_valid": true,
  "start": {"history": [], "total": "0"},
  "calls": [
    {
      "now": 9,
      "amount": "10",
      "expected": {"ok": {"history": [{"ledger": 9, "amount": "10"}], "total": "10"}}
    },
    {"now": 8, "amount": "1", "expected": {"error": "ledger_before_newest"}},
    {"now": 0, "amount": "1", "expected": {"error": "ledger_before_newest"}},
    {
      "now": 9,
      "amount": "1",
      "expected": {
        "ok": {
          "history": [{"ledger": 9, "amount": "10"}, {"ledger": 9, "amount": "1"}],
          "total": "11"
        }
      }
    },
    {
      "now": 10,
      "amount": "1",
      "expected": {
        "ok": {
          "history": [
            {"ledger": 9, "amount": "10"},
            {"ledger": 9, "amount": "1"},
            {"ledger": 10, "amount": "1"}
          ],
          "total": "12"
        }
      }
    },
    {"now": 9, "amount": "1", "expected": {"error": "ledger_before_newest"}}
  ]
}
