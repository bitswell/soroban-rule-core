{
  "format": 1,
  "name": "cap-lowered-limit",
  "description": "Over a record built under a higher limit, a positive spend is refused until eviction brings the total plus the amount within the lowered limit.",
  "limit": "50",
  "period": 10,
  "params_valid": true,
  "start": {
    "history": [{"ledger": 1, "amount": "30"}, {"ledger": 3, "amount": "30"}],
    "total": "60"
  },
  "calls": [
    {"now": 4, "amount": "1", "expected": {"error": "limit_exceeded"}},
    {
      "now": 11,
      "amount": "20",
      "expected": {
        "ok": {
          "history": [{"ledger": 3, "amount": "30"}, {"ledger": 11, "amount": "20"}],
          "total": "50"
        }
      }
    },
    {"now": 11, "amount": "21", "expected": {"error": "limit_exceeded"}},
    {"now": 12, "amount": "1", "expected": {"error": "limit_exceeded"}},
    {
      "now": 13,
      "amount": "30",
      "expected": {
        "ok": {
          "history": [{"ledger": 11, "amount": "20"}, {"ledger": 13, "amount": "30"}],
          "total": "50"
        }
      }
    },
    {"now": 13, "amount": "1", "expected": {"error": "limit_exceeded"}}
  ]
}
