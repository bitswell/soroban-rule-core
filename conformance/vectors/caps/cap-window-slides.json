{
  "format": 1,
  "name": "cap-window-slides",
  "description": "Entries at or before now - period are evicted: at ledger 20 with period 10, ledger 10 is evicted and ledger 11 kept.",
  "limit": "100",
  "period": 10,
  "params_valid": true,
  "start": {"history": [], "total": "0"},
  "calls": [
    {
      "now": 10,
      "amount": "30",
      "expected": {"ok": {"history": [{"ledger": 10, "amount": "30"}], "total": "30"}}
    },
    {
      "now": 11,
      "amount": "30",
      "expected": {
        "ok": {
          "history": [{"ledger": 10, "amount": "30"}, {"ledger": 11, "amount": "30"}],
          "total": "60"
        }
      }
    },
    {
      "now": 12,
      "amount": "30",
      "expected": {
        "ok": {
          "history": [
            {"ledger": 10, "amount": "30"},
            {"ledger": 11, "amount": "30"},
            {"ledger": 12, "amount": "30"}
          ],
          "total": "90"
        }
      }
    },
    {"now": 19, "amount": "11", "expected": {"error": "limit_exceeded"}},
    {
      "now": 19,
      "amount": "10",
      "expected": {
        "ok": {
          "history": [
            {"ledger": 10, "amount": "30"},
            {"ledger": 11, "amount": "30"},
            {"ledger": 12, "amount": "30"},
            {"ledger": 19, "amount": "10"}
          ],
          "total": "100"
        }
      }
    },
    {"now": 20, "amount": "41", "expected": {"error": "limit_exceeded"}},
    {
      "now": 20,
      "amount": "30",
      "expected": {
        "ok": {
          "history": [
            {"ledger": 11, "amount": "30"},
            {"ledger": 12, "amount": "30"},
            {"ledger": 19, "amount": "10"},
            {"ledger": 20, "amount": "30"}
          ],
          "total": "100"
        }
      }
    },
    {"now": 21, "amount": "31", "expected": {"error": "limit_exceeded"}},
    {
      "now": 1000,
      "amount": "100",
      "expected": {"ok": {"history": [{"ledger": 1000, "amount": "100"}], "total": "100"}}
    }
  ]
}
