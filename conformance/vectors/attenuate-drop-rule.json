{
  "format": 1,
  "name": "attenuate-drop-rule",
  "description": "dropRule at each index, at the length, and at 2^31 and 2^32 - 1.",
  "rules": [
    {
      "contract": "746f6b656e",
      "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
      "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
    },
    {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
    {
      "contract": "646578",
      "functions": ["73776170"],
      "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
    }
  ],
  "batch": [
    {
      "call": {
        "contract": "746f6b656e",
        "function": "7472616e73666572",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "746f6b656e",
        "function": "617070726f7665",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "746f6b656e",
        "function": "6275726e",
        "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
      }
    },
    {
      "call": {
        "contract": "706f6f6c",
        "function": "6465706f736974",
        "args": [{"address": "626f62"}]
      }
    },
    {"call": {"contract": "646578", "function": "73776170", "args": [{"address": "616c696365"}]}},
    {"call": {"contract": "646578", "function": "73776170", "args": [{"address": "626f62"}]}}
  ],
  "expected": {"allows": [true, true, true, true, true, false], "allows_all": false},
  "attenuations": [
    {
      "steps": [{"drop_rule": {"index": 0}}],
      "expected": {
        "ok": {
          "rules": [
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []},
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [false, false, false, true, true, false],
          "allows_all": false
        }
      }
    },
    {
      "steps": [{"drop_rule": {"index": 1}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {
              "contract": "646578",
              "functions": ["73776170"],
              "conds": [{"arg_eq": {"index": 0, "value": {"address": "616c696365"}}}]
            }
          ],
          "allows": [true, true, true, false, true, false],
          "allows_all": false
        }
      }
    },
    {
      "steps": [{"drop_rule": {"index": 2}}],
      "expected": {
        "ok": {
          "rules": [
            {
              "contract": "746f6b656e",
              "functions": ["7472616e73666572", "617070726f7665", "6275726e", "7472616e73666572"],
              "conds": [{"arg_i128_at_most": {"index": 2, "bound": "100"}}]
            },
            {"contract": "706f6f6c", "functions": ["6465706f736974"], "conds": []}
          ],
          "allows": [true, true, true, true, false, false],
          "allows_all": false
        }
      }
    },
    {"steps": [{"drop_rule": {"index": 3}}], "expected": {"error": "no_such_rule"}},
    {"steps": [{"drop_rule": {"index": 2147483648}}], "expected": {"error": "no_such_rule"}},
    {"steps": [{"drop_rule": {"index": 4294967295}}], "expected": {"error": "no_such_rule"}}
  ]
}
