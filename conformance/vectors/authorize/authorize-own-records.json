{
  "format": 1,
  "name": "authorize-own-records",
  "description": "Two capped rules for the same call keep their own records, and a rule without a cap keeps its record as it was.",
  "rules": [
    {
      "contract": "746f6b656e",
      "functions": ["7472616e73666572"],
      "conds": [],
      "signers": [],
      "threshold": 0,
      "cap": {"limit": "100", "period": 10, "amount_arg": 2}
    },
    {
      "contract": "746f6b656e",
      "functions": ["7472616e73666572"],
      "conds": [],
      "signers": [],
      "threshold": 0,
      "cap": {"limit": "50", "period": 10, "amount_arg": 2}
    },
    {
      "contract": "7661756c74",
      "functions": ["6465706f736974"],
      "conds": [],
      "signers": [{"delegated": {"address": "616c696365"}}],
      "threshold": 1,
      "cap": null
    }
  ],
  "start": [
    {"history": [], "total": "0"},
    {"history": [], "total": "0"},
    {"history": [{"ledger": 3, "amount": "7"}], "total": "7"}
  ],
  "authorizations": [
    {
      "batch": [
        {
          "call": {
            "contract": "746f6b656e",
            "function": "7472616e73666572",
            "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "100"}]
          }
        },
        {
          "call": {
            "contract": "746f6b656e",
            "function": "7472616e73666572",
            "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "50"}]
          }
        }
      ],
      "choices": [0, 1],
      "authenticated": [],
      "now": 1,
      "expected": {
        "ok": [
          {"history": [{"ledger": 1, "amount": "100"}], "total": "100"},
          {"history": [{"ledger": 1, "amount": "50"}], "total": "50"},
          {"history": [{"ledger": 3, "amount": "7"}], "total": "7"}
        ]
      }
    },
    {
      "batch": [
        {
          "call": {
            "contract": "746f6b656e",
            "function": "7472616e73666572",
            "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "1"}]
          }
        }
      ],
      "choices": [0],
      "authenticated": [],
      "now": 2,
      "expected": {"error": "cap_limit_exceeded"}
    },
    {
      "batch": [
        {
          "call": {
            "contract": "746f6b656e",
            "function": "7472616e73666572",
            "args": [{"address": "616c696365"}, {"address": "626f62"}, {"i128": "1"}]
          }
        }
      ],
      "choices": [1],
      "authenticated": [],
      "now": 2,
      "expected": {"error": "cap_limit_exceeded"}
    },
    {
      "batch": [{"call": {"contract": "7661756c74", "function": "6465706f736974", "args": []}}],
      "choices": [2],
      "authenticated": [{"delegated": {"address": "616c696365"}}],
      "now": 9,
      "expected": {
        "ok": [
          {"history": [{"ledger": 1, "amount": "100"}], "total": "100"},
          {"history": [{"ledger": 1, "amount": "50"}], "total": "50"},
          {"history": [{"ledger": 3, "amount": "7"}], "total": "7"}
        ]
      }
    }
  ]
}
