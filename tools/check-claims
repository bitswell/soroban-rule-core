#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""Check the claim ledger (claims.yaml) against the repository.

Every claim has a status and evidence. The status fixes which kinds of
evidence the claim must and may cite:

  status     must cite            may also cite
  proven     theorem              file
  tested     test or ci           file
  measured   file                 ci
  assumed    trusted              file
  unproven   file or trusted      -

and every cited piece of evidence must exist:

  theorem  NAME             NAME is an exported theorem of the Lean package
                            in formal/ (see --theorems).
  test     PKG/TARGET::PATH a Rust test of that name exists: TARGET is a
                            test target of workspace package PKG, as
                            `cargo test --no-run` builds it, and PATH is a
                            test that target's `--list` prints.
  ci       {workflow, job, step[, runs][, matrix]}
                            the workflow runs on every pull request and on
                            every push to main, has that job and that step
                            (by name), neither is conditional or allowed to
                            fail, the step's `run` contains `runs`, and the
                            job's matrix has an entry with every value
                            `matrix` gives (one of its `include` entries, or
                            a value of each named axis).
  file     PATH [contains: TEXT]
                            PATH exists; with `contains`, it is a file
                            holding TEXT.
  trusted  HEADING          TRUSTED.md has a heading with exactly that text.

A claim may list `assumes:`, the ids of the assumed claims it rests on; each
must exist and be assumed.

Theorem names are checked in one of two ways (--theorems):

  record  (default) NAME appears in the #print_package_axioms record of
          formal/RuleCore/Axioms.lean. `lake build` checks that record under
          #guard_msgs against `#print axioms` for every exported theorem of
          the package, so on a tree whose Lean build passes, the record lists
          exactly the exported theorems.
  lean    Lean itself resolves NAME in the built package: the checker writes
          a Lean file that imports RuleCore and checks, for each name, that
          it is a theorem declared in a RuleCore module, and runs it with
          `lake env lean` in formal/. Needs a finished `lake build`.

Test names come from cargo (`cargo test --workspace --locked --no-run`, then
each test executable's `--list`), for the repository's workspace and for each
other workspace with a Cargo.lock that git tracks (a host entry of
conformance/host that pins its own host), unless --test-list names a file
holding one PKG/TARGET::PATH per line. --skip-tests leaves test names unchecked, for a
run where another one checks them.

Usage: tools/check-claims [--root DIR] [--ledger FILE] [--theorems record|lean]
                          [--test-list FILE | --skip-tests]
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml

STATUSES = ("proven", "tested", "measured", "assumed", "unproven")
KINDS = ("theorem", "test", "ci", "file", "trusted")

# Kinds a claim of each status must cite at least one of, and may cite.
REQUIRED = {
    "proven": {"theorem"},
    "tested": {"test", "ci"},
    "measured": {"file"},
    "assumed": {"trusted"},
    "unproven": {"file", "trusted"},
}
ALLOWED = {
    "proven": {"theorem", "file"},
    "tested": {"test", "ci", "file"},
    "measured": {"file", "ci"},
    "assumed": {"trusted", "file"},
    "unproven": {"file", "trusted"},
}

CLAIM_KEYS = {"id", "claim", "status", "evidence", "assumes"}
CI_KEYS = {"workflow", "job", "step", "runs", "matrix"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*$")
LEAN_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_'!?]*(\.[A-Za-z_][A-Za-z0-9_'!?]*)*$")
TEST_RE = re.compile(r"^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+::[A-Za-z0-9_:]+$")

AXIOMS_FILE = Path("formal/RuleCore/Axioms.lean")
RECORD_RE = re.compile(r"/--\n(.*?)-/\s*#guard_msgs in\s*#print_package_axioms", re.S)
RECORD_LINE_RE = re.compile(r"^info: '([^']+)' (?:depends on axioms: \[.*\]|does not depend on any axioms)$")


class Ledger:
    """The claims of one ledger file, with the errors found so far."""

    def __init__(self, path: Path):
        self.path = path
        self.errors: list[str] = []
        self.claims: list[dict] = []

    def error(self, where: str, message: str) -> None:
        self.errors.append(f"{self.path}: {where}: {message}")


def load(ledger: Ledger) -> None:
    try:
        data = yaml.safe_load(ledger.path.read_text())
    except (OSError, yaml.YAMLError) as e:
        ledger.error("ledger", f"cannot read: {e}")
        return
    if not isinstance(data, dict) or set(data) != {"claims"} or not isinstance(data["claims"], list):
        ledger.error("ledger", "must be a mapping with one key, `claims`, holding a list")
        return
    seen: set[str] = set()
    for n, claim in enumerate(data["claims"], 1):
        where = f"claim {n}"
        if not isinstance(claim, dict):
            ledger.error(where, "must be a mapping")
            continue
        cid = claim.get("id")
        if not isinstance(cid, str) or not ID_RE.match(cid):
            ledger.error(where, "`id` must be lowercase letters, digits, `.` and `-`")
            continue
        where = cid
        if cid in seen:
            ledger.error(where, "duplicate id")
        seen.add(cid)
        for key in sorted(set(claim) - CLAIM_KEYS):
            ledger.error(where, f"unknown key `{key}`")
        if not isinstance(claim.get("claim"), str) or not claim["claim"].strip():
            ledger.error(where, "`claim` must be a non-empty string")
        if claim.get("status") not in STATUSES:
            ledger.error(where, f"`status` must be one of {', '.join(STATUSES)}")
            continue
        if not isinstance(claim.get("evidence"), list):
            ledger.error(where, "`evidence` must be a list")
            continue
        if not isinstance(claim.get("assumes", []), list):
            ledger.error(where, "`assumes` must be a list of claim ids")
            continue
        ledger.claims.append(claim)


def evidence_kind(ledger: Ledger, where: str, item) -> str | None:
    """The kind of one evidence item, after checking its shape."""
    if not isinstance(item, dict):
        ledger.error(where, f"evidence {item!r} must be a mapping")
        return None
    kinds = [k for k in KINDS if k in item]
    if len(kinds) != 1:
        ledger.error(where, f"evidence {item!r} must name exactly one of {', '.join(KINDS)}")
        return None
    kind = kinds[0]
    extra = set(item) - {kind} - ({"contains"} if kind == "file" else set())
    if extra:
        ledger.error(where, f"{kind} evidence has unknown keys {sorted(extra)}")
        return None
    value = item[kind]
    if kind == "ci":
        if not isinstance(value, dict) or not {"workflow", "job", "step"} <= set(value) <= CI_KEYS:
            ledger.error(
                where, "ci evidence needs `workflow`, `job` and `step`, and may give `runs` and `matrix`"
            )
            return None
        matrix = value.get("matrix")
        fields_ok = all(isinstance(v, str) for k, v in value.items() if k != "matrix")
        matrix_ok = matrix is None or (
            isinstance(matrix, dict) and matrix and all(isinstance(v, str) for v in matrix.values())
        )
        if not (fields_ok and matrix_ok):
            ledger.error(where, "ci evidence fields must be strings, and `matrix` a mapping of strings")
            return None
    elif not isinstance(value, str) or not value:
        ledger.error(where, f"{kind} evidence must be a non-empty string")
        return None
    if kind == "file" and "contains" in item and not isinstance(item["contains"], str):
        ledger.error(where, "`contains` must be a string")
        return None
    if kind == "theorem" and not LEAN_NAME_RE.match(value):
        ledger.error(where, f"`{value}` is not a Lean name")
        return None
    if kind == "test" and not TEST_RE.match(value):
        ledger.error(where, f"`{value}` is not of the form PKG/TARGET::PATH")
        return None
    return kind


def record_theorems(root: Path) -> set[str]:
    """The theorem names in Axioms.lean's #print_package_axioms record."""
    text = (root / AXIOMS_FILE).read_text()
    blocks = RECORD_RE.findall(text)
    if len(blocks) != 1:
        raise SystemExit(f"{AXIOMS_FILE}: expected one #print_package_axioms record, found {len(blocks)}")
    names = set()
    for line in blocks[0].splitlines():
        m = RECORD_LINE_RE.match(line)
        if m:
            names.add(m.group(1))
        elif line.strip() and line.strip() != "---":
            raise SystemExit(f"{AXIOMS_FILE}: unexpected line in the axioms record: {line!r}")
    return names


LEAN_CHECK = """\
import Lean
import RuleCore

open Lean Elab Command

/-- Reports whether a name is a theorem declared in a module of the package. -/
elab "#claimed_theorem " id:ident : command => do
  let n := id.getId
  let env ← getEnv
  let inPackage := match env.getModuleIdxFor? n with
    | some idx => (env.header.moduleNames[idx.toNat]!).getRoot == `RuleCore
    | none => false
  let verdict := match env.find? n with
    | some (.thmInfo _) => if inPackage then "ok" else "outside-package"
    | some _ => "not-a-theorem"
    | none => "unknown"
  logInfo m!"claimed-theorem {verdict} {n}"
"""
LEAN_VERDICT_RE = re.compile(r"claimed-theorem (\S+) (\S+)")


def lean_theorems(root: Path, names: set[str]) -> set[str]:
    """The names among `names` that Lean resolves to theorems of the package."""
    if not names:
        return set()
    with tempfile.TemporaryDirectory() as tmp:
        check = Path(tmp) / "Claims.lean"
        ordered = sorted(names)
        check.write_text(LEAN_CHECK + "".join(f"\n#claimed_theorem {n}" for n in ordered) + "\n")
        run = subprocess.run(["lake", "env", "lean", str(check)], cwd=root / "formal", capture_output=True, text=True)
    verdicts = dict((name, verdict) for verdict, name in LEAN_VERDICT_RE.findall(run.stdout))
    if run.returncode != 0 or set(verdicts) != names:
        raise SystemExit(f"lake env lean failed on the theorem check:\n{run.stdout}{run.stderr}")
    return {n for n, v in verdicts.items() if v == "ok"}


def workspaces(root: Path) -> list[Path]:
    """The manifest of the repository's workspace, then of every other
    workspace whose Cargo.lock git tracks."""
    listed = subprocess.run(
        ["git", "ls-files", "--", "*Cargo.lock"], cwd=root, check=True, capture_output=True, text=True
    ).stdout.split()
    others = sorted(root / Path(lock).parent / "Cargo.toml" for lock in listed if Path(lock).parent != Path("."))
    return [root / "Cargo.toml", *others]


def cargo_tests(root: Path) -> set[str]:
    """PKG/TARGET::PATH for every test cargo builds in the repository's
    workspaces."""
    tests = set()
    for manifest in workspaces(root):
        tests |= workspace_tests(root, manifest)
    return tests


def workspace_tests(root: Path, manifest: Path) -> set[str]:
    """PKG/TARGET::PATH for every test cargo builds in one workspace."""
    meta = json.loads(
        subprocess.run(
            ["cargo", "metadata", "--format-version", "1", "--no-deps", "--locked", "--manifest-path", manifest],
            cwd=root,
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    )
    packages = {p["id"]: p["name"] for p in meta["packages"]}
    build = subprocess.run(
        [
            "cargo",
            "test",
            "--workspace",
            "--locked",
            "--no-run",
            "--message-format=json",
            "--manifest-path",
            manifest,
        ],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if build.returncode != 0:
        raise SystemExit(f"cargo test --no-run failed:\n{build.stderr}")
    tests = set()
    for line in build.stdout.splitlines():
        msg = json.loads(line)
        if msg.get("reason") != "compiler-artifact" or not msg["profile"]["test"] or not msg.get("executable"):
            continue
        listing = subprocess.run(
            [msg["executable"], "--list", "--format", "terse"], check=True, capture_output=True, text=True
        ).stdout
        prefix = f"{packages[msg['package_id']]}/{msg['target']['name']}::"
        for entry in listing.splitlines():
            if entry.endswith(": test"):
                tests.add(prefix + entry.removesuffix(": test"))
    return tests


def trusted_headings(root: Path) -> set[str]:
    path = root / "TRUSTED.md"
    if not path.is_file():
        return set()
    return {m.group(1).strip() for m in re.finditer(r"^#{1,6} +(.+?) *#*$", path.read_text(), re.M)}


def check_ci(root: Path, ci: dict) -> str | None:
    """Why a ci evidence item does not hold, or None."""
    path = root / ci["workflow"]
    try:
        flow = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as e:
        return f"cannot read workflow {ci['workflow']}: {e}"
    # YAML 1.1 reads the bare key `on` as true.
    triggers = flow.get("on", flow.get(True)) if isinstance(flow, dict) else None
    if isinstance(triggers, str):
        triggers = [triggers]
    if isinstance(triggers, list):
        triggers = {t: None for t in triggers}
    if not isinstance(triggers, dict) or "pull_request" not in triggers or "push" not in triggers:
        return f"{ci['workflow']} does not run on every pull request and push"
    for event in ("pull_request", "push"):
        spec = triggers[event] or {}
        if any(k in spec for k in ("paths", "paths-ignore", "branches-ignore", "tags")):
            return f"{ci['workflow']} filters its {event} trigger"
        if event == "pull_request" and "branches" in spec:
            return f"{ci['workflow']} filters its pull_request trigger"
    if "main" not in ((triggers["push"] or {}).get("branches") or ["main"]):
        return f"{ci['workflow']} does not run on pushes to main"
    job = (flow.get("jobs") or {}).get(ci["job"])
    if not isinstance(job, dict):
        return f"{ci['workflow']} has no job `{ci['job']}`"
    if "if" in job or job.get("continue-on-error"):
        return f"job `{ci['job']}` is conditional or may fail"
    steps = [s for s in job.get("steps") or [] if isinstance(s, dict) and s.get("name") == ci["step"]]
    if len(steps) != 1:
        return f"job `{ci['job']}` has no step named `{ci['step']}`"
    step = steps[0]
    if "if" in step or step.get("continue-on-error"):
        return f"step `{ci['step']}` is conditional or may fail"
    if "runs" in ci and ci["runs"] not in (step.get("run") or ""):
        return f"step `{ci['step']}` does not run `{ci['runs']}`"
    if "matrix" in ci and not matrix_has(job, ci["matrix"]):
        return f"job `{ci['job']}` has no matrix entry {ci['matrix']}"
    return None


def matrix_has(job: dict, want: dict) -> bool:
    """Whether one entry of the job's matrix has every value of `want`."""
    matrix = (job.get("strategy") or {}).get("matrix")
    if not isinstance(matrix, dict):
        return False
    include = matrix.get("include") or []
    if any(isinstance(e, dict) and all(e.get(k) == v for k, v in want.items()) for e in include):
        return True
    return all(isinstance(matrix.get(k), list) and v in matrix[k] for k, v in want.items())


def article(word: str) -> str:
    return "an" if word[0] in "aeiou" else "a"


def check(ledger: Ledger, root: Path, theorems: str, test_list: Path | None, skip_tests: bool = False) -> None:
    load(ledger)
    claims = ledger.claims
    by_id = {c["id"]: c for c in claims}

    cited: dict[str, set[str]] = {k: set() for k in KINDS if k not in ("ci", "file")}
    parsed: list[tuple[dict, list[tuple[str, dict]]]] = []
    for claim in claims:
        items = []
        for item in claim["evidence"]:
            kind = evidence_kind(ledger, claim["id"], item)
            if kind is not None:
                items.append((kind, item))
                if kind in cited:
                    cited[kind].add(item[kind])
        parsed.append((claim, items))

    known_theorems = record_theorems(root) if theorems == "record" else lean_theorems(root, cited["theorem"])
    if cited["test"] and not skip_tests:
        known_tests = (
            {line.strip() for line in test_list.read_text().splitlines() if line.strip()}
            if test_list
            else cargo_tests(root)
        )
    else:
        known_tests = set()
    headings = trusted_headings(root)

    for claim, items in parsed:
        cid, status = claim["id"], claim["status"]
        kinds = {kind for kind, _ in items}
        if not kinds & REQUIRED[status]:
            need = " or ".join(sorted(REQUIRED[status]))
            ledger.error(cid, f"{article(status)} {status} claim must cite {need} evidence")
        for kind in sorted(kinds - ALLOWED[status]):
            ledger.error(cid, f"{article(status)} {status} claim cannot cite {kind} evidence")
        for dep in claim.get("assumes", []):
            if dep not in by_id:
                ledger.error(cid, f"assumes `{dep}`, which is not a claim")
            elif by_id[dep]["status"] != "assumed":
                ledger.error(cid, f"assumes `{dep}`, which is {by_id[dep]['status']}, not assumed")
        for kind, item in items:
            value = item[kind]
            if kind == "theorem" and value not in known_theorems:
                ledger.error(cid, f"theorem `{value}` is not an exported theorem of the Lean package")
            elif kind == "test" and not skip_tests and value not in known_tests:
                ledger.error(cid, f"test `{value}` does not exist")
            elif kind == "trusted" and value not in headings:
                ledger.error(cid, f"TRUSTED.md has no heading `{value}`")
            elif kind == "ci":
                why = check_ci(root, value)
                if why:
                    ledger.error(cid, why)
            elif kind == "file":
                path = root / value
                if not path.exists():
                    ledger.error(cid, f"file `{value}` does not exist")
                elif "contains" in item and (not path.is_file() or item["contains"] not in path.read_text()):
                    ledger.error(cid, f"file `{value}` does not contain {item['contains']!r}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Check claims.yaml against the repository.")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--ledger", type=Path, help="default: ROOT/claims.yaml")
    parser.add_argument("--theorems", choices=("record", "lean"), default="record")
    tests = parser.add_mutually_exclusive_group()
    tests.add_argument("--test-list", type=Path)
    tests.add_argument("--skip-tests", action="store_true")
    args = parser.parse_args(argv)

    ledger = Ledger(args.ledger or args.root / "claims.yaml")
    check(ledger, args.root, args.theorems, args.test_list, args.skip_tests)
    if ledger.errors:
        for e in ledger.errors:
            print(e, file=sys.stderr)
        print(f"{len(ledger.errors)} problem(s) in {ledger.path}", file=sys.stderr)
        return 1
    counts = {s: sum(c["status"] == s for c in ledger.claims) for s in STATUSES}
    summary = ", ".join(f"{n} {s}" for s, n in counts.items() if n)
    print(f"{ledger.path}: {len(ledger.claims)} claims, evidence present ({summary})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
